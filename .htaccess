RewriteEngine On
RewriteBase /

# The production virtual host serves this project at the domain root.
# Explicitly declare the frontend entry point for hosts that do not include
# index.html in DirectoryIndex by default.
DirectoryIndex index.html

# API Gateway
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api(?:/(.*))?$ gateway/index.php [QSA,L]

# Do not rewrite the root to public/login.html here. DirectoryIndex serves
# index.html, whose browser-side redirect preserves the HTTPS scheme and lets
# relative public/ asset paths resolve correctly.
